{
  "name": "@apexwoot/mr-scraper",
  "version": "2.2.0",
  "description": "TypeScript library for scraping LinkedIn person profiles using Playwright",
  "type": "module",
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./dist/bun/index.js",
      "node": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "linkedin",
    "scraper",
    "playwright",
    "typescript",
    "web-scraping",
    "linkedin-api",
    "linkedin-scraper"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apex-woot/mr-scraper.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "bugs": {
    "url": "https://github.com/apex-woot/mr-scraper/issues"
  },
  "homepage": "https://github.com/apex-woot/mr-scraper#readme",
  "author": "apexwoot",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "playwright": "^1.58.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "latest",
    "husky": "^9.1.7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "test": "bun test",
    "test:fast": "bun test ./tests/auth.unit.test.ts ./tests/parsers/*.test.ts ./src/scrapers/person/*.test.ts",
    "test:ci": "bun test",
    "scrape": "bun run index.ts",
    "scrape:person": "bun run examples/scrape_core_sections_json.ts",
    "scrape:summary": "bun run examples/scrape_summary.ts",
    "scrape:core-json": "bun run examples/scrape_core_sections_json.ts",
    "scrape:session:rust": "bun run examples/capture_voyager_session.ts",
    "scrape:profile:voyager": "bun run examples/scrape_profile_with_voyager.ts",
    "scrape:person:voyager": "bun run examples/scrape_profile_with_voyager.ts",
    "auth:save-cookie": "bun run examples/save_li_at_cookie.ts",
    "scrape:details": "bun run examples/scrape_details_section.ts",
    "scrape:education": "bun run examples/scrape_education_only.ts",
    "scrape:publications": "bun run examples/scrape_publications_only.ts",
    "env:fetch": "infisical export --projectId=7b57b769-9557-4449-9d88-261cd09a31c2 --env=prod --path=/ > .env",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build": "bun run build.ts",
    "prepare": "husky",
    "prepublishOnly": "bun run build && bun test"
  }
}
